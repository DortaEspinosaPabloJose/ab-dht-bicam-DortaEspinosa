# Doxyfile para BiCIAM (proyecto Java / Maven)
# Generar con:  doxygen Doxyfile      (desde la raíz del proyecto)

PROJECT_NAME           = "BiCIAM"
PROJECT_NUMBER         = 1.0-SNAPSHOT
PROJECT_BRIEF          = "Metaheurísticas y algoritmos evolutivos"
OUTPUT_DIRECTORY       = docs
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = Spanish
DOXYFILE_ENCODING      = UTF-8
INPUT_ENCODING         = UTF-8

# --- Entrada ---------------------------------------------------------------
INPUT                  = src/main/java
FILE_PATTERNS          = *.java
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */target/* */bin/*

# --- Lenguaje --------------------------------------------------------------
OPTIMIZE_OUTPUT_JAVA   = YES
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES

# --- Qué se documenta ------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_ANON_NSPACES   = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

# --- Avisos ----------------------------------------------------------------
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_LOGFILE           = docs/doxygen-warnings.log

# --- Navegación y código fuente -------------------------------------------
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
GENERATE_TREEVIEW      = YES
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = src/main/java

# --- Salida ----------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
SEARCHENGINE           = YES

# --- Diagramas (poner HAVE_DOT = YES si está instalado graphviz) ----------
HAVE_DOT               = NO
UML_LOOK               = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
